          <td style="width: 50%; border: 1px solid #000000; padding: 4px;">Kunci Jawaban / Pembahasan</td>
          <td style="width: 20%; border: 1px solid #000000; padding: 4px;">Bobot Skor</td>
        </tr>
        ${allQuestions.map((q, idx) => `
          <tr>
