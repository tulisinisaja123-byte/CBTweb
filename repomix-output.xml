              <span>{loading ? 'Memeriksa...' : 'Masuk ke CBT'}</span>
            </button>
          </form>

          {/* Demo account selector pills */}
          <div className="mt-6 pt-5 border-t border-[#DEE2E6]">
            <p className="text-xs font-medium text-[#6C757D] mb-2.5">Pilih Akun Demo Cepat (1 Sampel):</p>
