                <tbody className="divide-y divide-[#DEE2E6]">
                  {MA_CIKARAMAS_SUBJECTS.map(s => (
                    <tr key={s.code} className="hover:bg-[#F8F9FA]">
                      <td className="py-2 px-2 text-center font-bold font-mono text-[#0052CC] text-sm">
