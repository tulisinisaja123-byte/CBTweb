              </p>
            </div>

            <button
              type="button"
              onClick={() => setActiveViolationModal(null)}
              className="w-full py-3 px-6 rounded-xl bg-[#DC3545] hover:bg-[#C82333] text-white font-bold text-xs shadow-md transition-all cursor-pointer"
