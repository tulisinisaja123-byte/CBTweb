  title: string;
  shortDesc: string;
  fullDesc: string;
  inputs: string[];
  outputs: string[];
  targetPage?: string;
  targetButtonLabel?: string;
  tips: string;
  badge: string;
  category: 'SETUP' | 'CONTENT' | 'SCHEDULE' | 'DOCS' | 'EXAM' | 'GRADING';
