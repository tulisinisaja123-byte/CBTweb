              className="w-full mt-2 py-2.5 px-4 rounded-md bg-[#0052CC] hover:bg-[#0047B3] text-white font-medium text-xs sm:text-sm flex items-center justify-center gap-2 transition-colors shadow-xs disabled:opacity-50"
            >
