import React, { useState, useEffect } from 'react';
import {
  Compass,
  CheckCircle2,
  Circle,
  ArrowRight,
  Printer,
  FileText,
  HelpCircle,
  Calendar,
  CreditCard,
  Activity,
  ClipboardCheck,
  FileCheck2,
  Users,
  GraduationCap,
