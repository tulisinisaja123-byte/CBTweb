                    const syncMatching = (
                      newLeft: { key: string; text: string }[],
                      newPairs: Record<string, string>,
                      newOpts?: Partial<{ OPTION_A: string; OPTION_B: string; OPTION_C: string; OPTION_D: string; OPTION_E: string }>
