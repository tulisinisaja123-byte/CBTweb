    isOpen: boolean;
    rowIndex: number;
    currentPeriodLabel: string;
  } | null>(null);
  const [jamInput, setJamInput] = useState('');

  // 4. Edit Activity (Pre, Break, Post, Special)
  const [activityEditModal, setActivityEditModal] = useState<{
    isOpen: boolean;
