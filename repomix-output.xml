                }`}
              >
                <div className="font-bold">Siswa</div>
                <div className="text-[10px] opacity-80 truncate">siswa01 / Siswa123!</div>
              </button>
            </div>

            <div className="mt-4 flex items-center justify-between gap-2">
              <button
                type="button"
